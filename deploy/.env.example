# Dominio público sin barra final.
PASADATOS_DOMAIN=pasadatos.tudominio.com
PASADATOS_PUBLIC_URL=https://pasadatos.tudominio.com

# Red y configuración de Traefik existente.
TRAEFIK_NETWORK=traefik
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt

# Puerto local si usás Nginx/Caddy en vez de Traefik.
PASADATOS_LOCAL_PORT=8088

# Retención de archivos temporales y metadatos.
PASADATOS_FILE_TTL_HOURS=24
PASADATOS_METADATA_TTL_HOURS=720

# 0 = sin límite impuesto por pasaDATOS. El límite real será el disco/proxy/OS.
PASADATOS_MAX_FILE_BYTES=0
