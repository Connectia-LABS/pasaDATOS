server {
    listen 443 ssl http2;
    server_name pasadatos.tudominio.com;

    # Configurá tus certificados TLS aquí.
    ssl_certificate     /etc/letsencrypt/live/pasadatos.tudominio.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/pasadatos.tudominio.com/privkey.pem;

    # Sin límite artificial y sin buffering del archivo completo.
    client_max_body_size 0;
    proxy_request_buffering off;
    proxy_buffering off;
    proxy_read_timeout 86400s;
    proxy_send_timeout 86400s;
    send_timeout 86400s;

    location / {
        proxy_pass http://127.0.0.1:8088;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}
